# dual   = takmir bisa pilih "Semua akun" atau "Per akun"
# direct = langsung worksheet semua akun
# one    = langsung isi satu per satu
VITE_SALDO_AWAL_MODE=dual

# Backend Express (Railway) — dipakai untuk prefix yang belum pindah
VITE_API_URL=https://go-mosque-be-production.up.railway.app/api/v1

# Supabase Edge Function gateway.
# Contoh: https://<project-ref>.supabase.co/functions/v1/api
VITE_EDGE_API_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Prefix yang sudah di-cutover ke Edge, dipisah koma.
# Development: semua modul. Kosongkan untuk 100% Railway.
VITE_EDGE_PREFIXES=/auth,/notifications,/users,/role,/kategori-donasi,/kategori-pengeluaran-donasi,/statistik,/donasi,/donasi-masjid,/pengeluaran-donasi,/masjid,/coa,/jurnal,/laporan-keuangan,/system-admin
